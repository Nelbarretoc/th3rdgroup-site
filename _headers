/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://th3rdgroup-web.pages.dev https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https://th3rdgroup-web.pages.dev; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Public editions enforce their own restrictive meta CSP, including no API calls.
# Remove parent-only headers that otherwise prevent the intended inline demo.
/showcase/*
  ! Content-Security-Policy
  ! X-Frame-Options
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/th3rd-group-logo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/th3rd-group-logo-lockup.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/th3rd-group-logo-dark.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/th3rd-group-logo-dark-header.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/th3rd-group-logo-dark-footer.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
